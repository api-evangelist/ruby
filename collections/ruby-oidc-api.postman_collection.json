          "name": "Exchange OIDC Token For Trusted Publishing API Key",
          "request": {
            "name": "Exchange OIDC Token For Trusted Publishing API Key",
            "description": {
              "content": "Exchanges a CI provider OIDC token (GitHub Actions, GitLab CI, etc.) for a short-lived RubyGems API key scoped by a configured trusted-publishing role.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "oidc",
                "api_key_role",
                ":token",
                "assume_role"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "token",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jwt\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "05f2c031-f423-43ba-ae26-a783f331807a",
              "name": "Scoped, short-lived API key",
              "originalRequest": {
                "url": {
                  "path": [
