{
  "opencollection": "1.0.0",
  "info": {
    "name": "RubyGems.org Registry Activity Profiles API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Profiles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Authenticated User Profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://rubygems.org/api/v1/profiles/me.json",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns the profile of the authenticated user, including MFA level and handle."
        }
      ]
    }
  ],
  "bundled": true
}